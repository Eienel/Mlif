# Supabase (OPTIONAL): only powers the provider cache and per-IP fair-use cap.
# Leave blank to run without it. There are no user accounts.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # server only

# Gemini (Google AI Studio). Free tier. Server only, never NEXT_PUBLIC
GEMINI_API_KEY=

# Catalog and watch data
TMDB_API_KEY=                     # server only (v4 read access token, starts with ey)
WATCHMODE_API_KEY=                # server only

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
