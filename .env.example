# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only

# Gemini (Google AI Studio). Free tier. Server only, never NEXT_PUBLIC
GEMINI_API_KEY=

# Catalog and watch data
TMDB_API_KEY=                     # server only
WATCHMODE_API_KEY=                # server only

# Billing: Lemon Squeezy (worldwide card and PayPal, recurring subscriptions)
LEMONSQUEEZY_API_KEY=             # server only
LEMONSQUEEZY_STORE_ID=            # server only, your store id
LEMONSQUEEZY_VARIANT_ID=          # server only, the Pro subscription variant id
LEMONSQUEEZY_WEBHOOK_SECRET=      # server only, signing secret for the webhook

# Billing: Coinbase Commerce (USDC and other crypto, 30-day Pro pass)
COINBASE_COMMERCE_API_KEY=        # server only
COINBASE_COMMERCE_WEBHOOK_SECRET= # server only, shared webhook secret

# App
NEXT_PUBLIC_PRO_PRICE=5           # Pro monthly price in USD, display + crypto charge
NEXT_PUBLIC_SITE_URL=http://localhost:3000
